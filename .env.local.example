# ---------------------------------------------------------------------------
# Bahaba – Firebase & Ingestion Environment Variables
# ---------------------------------------------------------------------------

# Server-Side Firebase Admin SDK (Route handlers & Cron jobs)
# Pass JSON string or Base64-encoded service account key JSON
FIREBASE_SERVICE_ACCOUNT_KEY=

# Optional shared secret to protect /api/cron/ingest
CRON_SECRET=

# Client-Side Firebase Web SDK (React browser components & onSnapshot)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=bahaba-nicoleigames.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=bahaba-nicoleigames
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=bahaba-nicoleigames.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# MongoDB Configuration
# ---------------------------------------------------------------------------
MONGODB_URI=
MONGODB_DB=bahaba

